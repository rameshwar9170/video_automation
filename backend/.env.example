# AI YouTube Automation Platform - Environment Configuration
PORT=4000
NODE_ENV=development

# Database (SQLite zero-configuration local database)
DATABASE_URL="file:./dev.db"

# Google / Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth (YouTube Uploads)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/youtube/callback

# ElevenLabs (Voice TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ

# Tavily (AI Web Search / Trend Research & Video Discovery)
TAVILY_API_KEY=your_tavily_api_key

# Stock Video footage (Optional - Pexels / Pixabay free API keys)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Google Imagen (Image Generation Fallback)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3001

# File Storage
GENERATED_DIR=./generated

# Quality & Retry Config
MAX_RETRY_COUNT=3
QUALITY_THRESHOLD=70
